modules = ["nodejs-20"]
[agent]
expertMode = true
integrations = ["javascript_gemini:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Inject Mode"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Normal Mode"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Audio Mode (Inject)"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js --api"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Inject Mode"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js --sitekey 10000000-ffff-ffff-ffff-000000000001 --url https://accounts.hcaptcha.com/demo --mode inject"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Normal Mode"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js --sitekey 10000000-ffff-ffff-ffff-000000000001 --url https://accounts.hcaptcha.com/demo --mode normal"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Audio Mode (Inject)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js --sitekey 10000000-ffff-ffff-ffff-000000000001 --url https://accounts.hcaptcha.com/demo --mode inject --audio"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 33315
externalPort = 80

[[ports]]
localPort = 46495
externalPort = 3000
