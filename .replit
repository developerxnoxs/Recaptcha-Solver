modules = ["nodejs-20", "web"]
[agent]
expertMode = true
integrations = ["javascript_gemini:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node api-server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "tes"
mode = "sequential"
author = 49385010

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js --sitekey \"b4c45857-0e23-48e6-9017-e28fff99ffb2\" --url \"https://nopecha.com/demo/hcaptcha\" --screenshot"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34341
externalPort = 3003

[[ports]]
localPort = 34631
externalPort = 3001

[[ports]]
localPort = 39969
externalPort = 3002

[[ports]]
localPort = 46495
externalPort = 3000
